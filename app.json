{
  "expo": {
    "name": "FitNyx",
    "slug": "fitnyx-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitnyxmobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1dca1118-e477-40fe-9e29-df941784fb68",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitnyx.app",
      "backgroundColor": "#050505",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSMotionUsageDescription": "FitNyx counts your steps and notices vehicle travel during a Roam, so your distance and cadence stay accurate.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fitnyx.app",
      "backgroundColor": "#050505",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "fitnyxmobile",
              "host": "auth",
              "pathPrefix": "/callback"
            },
            {
              "scheme": "fitnyxmobile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-dev-client",
      "./plugins/withNotifeeRepo",
      "./plugins/withNotifIcon",
      "expo-live-activity",
      "./plugins/withWorkoutLiveActivity",
      "./plugins/withRoamNotification",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "fitnyx",
          "project": "fitnyx-mobile"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitNyx uses your location to map your route and measure distance and pace during a Roam.",
          "locationAlwaysAndWhenInUsePermission": "FitNyx keeps tracking your Roam route while your screen is locked or the app is in the background, so your run, walk or ride is recorded in full.",
          "locationAlwaysPermission": "FitNyx keeps tracking your Roam route while your screen is locked or the app is in the background, so your run, walk or ride is recorded in full.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fitnyx-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#050505"
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "FitNyx only saves your achievement cards to Photos; it doesn't browse your library.",
          "savePhotosPermission": "Save your FitNyx achievement cards to Photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "FitNyx reads your health data so your workouts, runs and weight stay in sync.",
          "NSHealthUpdateUsageDescription": "FitNyx saves your Roams, workouts and weight to Apple Health so they appear across your apps and watch."
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthConnectPermissions",
      "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LiveActivity",
                  "bundleIdentifier": "com.fitnyx.app.LiveActivity",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "1dca1118-e477-40fe-9e29-df941784fb68"
      }
    },
    "owner": "tarosh3"
  }
}
