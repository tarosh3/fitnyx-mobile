{
  "expo": {
    "name": "FitNyx",
    "slug": "fitnyx-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitnyxmobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitnyx.app",
      "backgroundColor": "#050505",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fitnyx.app",
      "backgroundColor": "#050505",
      "permissions": [
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "fitnyxmobile",
              "host": "auth",
              "pathPrefix": "/callback"
            },
            {
              "scheme": "fitnyxmobile"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-dev-client",
      "./plugins/withNotifeeRepo",
      "./plugins/withNotifIcon",
      "expo-live-activity",
      "@sentry/react-native/expo",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LiveActivity",
                  "bundleIdentifier": "com.fitnyx.app.LiveActivity",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "1dca1118-e477-40fe-9e29-df941784fb68"
      }
    },
    "owner": "tarosh3"
  }
}
